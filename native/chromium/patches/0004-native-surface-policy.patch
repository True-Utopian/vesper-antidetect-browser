+namespace blink {
+struct VesperNativeSurfacePolicy {
+  bool restrict_webgl;
+  bool restrict_local_fonts;
+  std::optional<uint64_t> audio_seed;
+  static const VesperNativeSurfacePolicy& Get() {
+    static const VesperNativeSurfacePolicy policy = [] {
+      const auto* command = base::CommandLine::ForCurrentProcess();
+      return VesperNativeSurfacePolicy{
+          vesper::Restricted(command->GetSwitchValueASCII("vesper-webgl-policy")),
+          vesper::Restricted(command->GetSwitchValueASCII("vesper-local-font-policy")),
+          vesper::AudioSeed(command->GetSwitchValueASCII("vesper-audio-seed"))};
+    }();
+    return policy;
+  }
+};
+}  // namespace blink
+#endif
