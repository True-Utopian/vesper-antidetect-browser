diff --git a/third_party/blink/common/device_memory/vesper_native_scalar_policy_unittest.cc b/third_party/blink/common/device_memory/vesper_native_scalar_policy_unittest.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/common/device_memory/vesper_native_scalar_policy_unittest.cc
@@ -0,0 +1,99 @@
+// Copyright 2026 true-utopian
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "third_party/blink/public/common/device_memory/vesper_native_scalar_policy.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/device_memory/approximated_device_memory.h"
+
+namespace blink {
+namespace {
+
+TEST(VesperNativeScalarPolicyTest, MissingSwitchesRetainNativeFallback) {
+  const base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  const auto policy = VesperNativeScalarPolicy::Parse(command_line);
+  EXPECT_FALSE(policy.hardware_concurrency.has_value());
+  EXPECT_FALSE(policy.device_memory.has_value());
+}
+
+TEST(VesperNativeScalarPolicyTest, CpuAcceptsBoundaries) {
+  for (const unsigned value : {1u, 8u, 1024u}) {
+    base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+    command_line.AppendSwitchASCII("vesper-hardware-concurrency",
+                                   base::NumberToString(value));
+    EXPECT_EQ(
+        VesperNativeScalarPolicy::Parse(command_line).hardware_concurrency,
+        value);
+  }
+}
+
+TEST(VesperNativeScalarPolicyTest, CpuRejectsMalformedOrUnboundedValues) {
+  for (const char* value : {"", "0", "01", "-1", "+4", "4.0", " 4", "4 ", "0x4",
+                            "1025", "4294967296", "eight"}) {
+    SCOPED_TRACE(value);
+    base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+    command_line.AppendSwitchASCII("vesper-hardware-concurrency", value);
+    EXPECT_FALSE(VesperNativeScalarPolicy::Parse(command_line)
+                     .hardware_concurrency.has_value());
+  }
+}
+
+TEST(VesperNativeScalarPolicyTest, MemoryAcceptsPlatformBuckets) {
+#if BUILDFLAG(IS_ANDROID)
+  const unsigned buckets[] = {1, 2, 4, 8};
+#else
+  const unsigned buckets[] = {2, 4, 8, 16, 32};
+#endif
+  for (const unsigned value : buckets) {
+    base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+    command_line.AppendSwitchASCII("vesper-device-memory",
+                                   base::NumberToString(value));
+    EXPECT_EQ(VesperNativeScalarPolicy::Parse(command_line).device_memory,
+              static_cast<float>(value));
+  }
+}
+
+TEST(VesperNativeScalarPolicyTest, MemoryRejectsNonCanonicalValues) {
+  for (const char* value : {"", "0", "0.25", "0.5", "3", "64", "-4", "4.0",
+                            "04", " 4", "4 ", "NaN", "Infinity"}) {
+    SCOPED_TRACE(value);
+    base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+    command_line.AppendSwitchASCII("vesper-device-memory", value);
+    EXPECT_FALSE(VesperNativeScalarPolicy::Parse(command_line)
+                     .device_memory.has_value());
+  }
+}
+
+TEST(VesperNativeScalarPolicyTest, FieldsFailIndependently) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendSwitchASCII("vesper-hardware-concurrency", "0");
+  command_line.AppendSwitchASCII("vesper-device-memory", "4");
+  const auto policy = VesperNativeScalarPolicy::Parse(command_line);
+  EXPECT_FALSE(policy.hardware_concurrency.has_value());
+  EXPECT_EQ(policy.device_memory, 4.0f);
+}
+
+TEST(VesperNativeScalarPolicyTest, MemoryRejectsOtherPlatformBuckets) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+#if BUILDFLAG(IS_ANDROID)
+  command_line.AppendSwitchASCII("vesper-device-memory", "16");
+#else
+  command_line.AppendSwitchASCII("vesper-device-memory", "1");
+#endif
+  EXPECT_FALSE(
+      VesperNativeScalarPolicy::Parse(command_line).device_memory.has_value());
+}
+
+TEST(VesperNativeScalarPolicyTest,
+     CommonGetterUsesLaunchPolicyOrNativeFallback) {
+  const auto expected =
+      VesperNativeScalarPolicy::Parse(*base::CommandLine::ForCurrentProcess());
+  ApproximatedDeviceMemory::SetPhysicalMemoryMBForTesting(8192);
+  EXPECT_EQ(ApproximatedDeviceMemory::GetApproximatedDeviceMemory(),
+            expected.device_memory.value_or(8.0f));
+  EXPECT_EQ(VesperNativeScalarPolicy::Get().hardware_concurrency,
+            expected.hardware_concurrency);
+}
+
+}  // namespace
+}  // namespace blink
