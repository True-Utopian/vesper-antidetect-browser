diff --git a/third_party/blink/public/common/device_memory/vesper_native_scalar_policy.h b/third_party/blink/public/common/device_memory/vesper_native_scalar_policy.h
new file mode 100644
--- /dev/null
+++ b/third_party/blink/public/common/device_memory/vesper_native_scalar_policy.h
@@ -0,0 +1,65 @@
+// Copyright 2026 true-utopian
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_DEVICE_MEMORY_VESPER_NATIVE_SCALAR_POLICY_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_DEVICE_MEMORY_VESPER_NATIVE_SCALAR_POLICY_H_
+
+#include <algorithm>
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "build/build_config.h"
+
+namespace blink {
+
+// Immutable process policy. Each Vesper profile owns a separate browser
+// process; every renderer inherits its scalar switches at creation.
+// Workers use the same native getters and require no script injection.
+struct VesperNativeScalarPolicy {
+  std::optional<unsigned> hardware_concurrency;
+  std::optional<float> device_memory;
+
+  static VesperNativeScalarPolicy Parse(const base::CommandLine& command_line) {
+    VesperNativeScalarPolicy policy;
+    const std::string cpu =
+        command_line.GetSwitchValueASCII("vesper-hardware-concurrency");
+    unsigned count = 0;
+    if (!cpu.empty() && cpu.front() != '0' &&
+        std::all_of(cpu.begin(), cpu.end(),
+                    [](char c) { return c >= '0' && c <= '9'; }) &&
+        base::StringToUint(cpu, &count) && count <= 1024) {
+      policy.hardware_concurrency = count;
+    }
+
+    const std::string memory =
+        command_line.GetSwitchValueASCII("vesper-device-memory");
+    // Match the pinned Chromium implementation's platform-specific buckets.
+    // Canonical strings intentionally reject NaN, fractions and whitespace.
+#if BUILDFLAG(IS_ANDROID)
+    constexpr unsigned kMemoryBuckets[] = {1, 2, 4, 8};
+#else
+    constexpr unsigned kMemoryBuckets[] = {2, 4, 8, 16, 32};
+#endif
+    for (const unsigned bucket : kMemoryBuckets) {
+      if (memory == base::NumberToString(bucket)) {
+        policy.device_memory = static_cast<float>(bucket);
+        break;
+      }
+    }
+    return policy;
+  }
+
+  static const VesperNativeScalarPolicy& Get() {
+    // Thread-safe C++ initialization: main-thread and worker getters share the
+    // launch policy. Invalid or absent fields keep Chromium's native fallback.
+    static const VesperNativeScalarPolicy policy =
+        Parse(*base::CommandLine::ForCurrentProcess());
+    return policy;
+  }
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_DEVICE_MEMORY_VESPER_NATIVE_SCALAR_POLICY_H_
