+std::unique_ptr<ImageDataBuffer> ImageDataBuffer::CreateForCanvasReadback(
+    scoped_refptr<StaticBitmapImage> image) {
+  auto buffer = Create(std::move(image));
+  if (!buffer) {
+    return nullptr;
+  }
+  const auto seed = VesperCanvasSeedFromCommandLine();
+  if (!seed || !IsVesperCanvasReadbackFormat(buffer->pixmap_)) {
+    return buffer;
+  }
+  auto protected_image =
+      CreateVesperCanvasReadbackImage(buffer->pixmap_, *seed);
+  if (!protected_image || !protected_image->peekPixels(&buffer->pixmap_)) {
+    // An enabled policy must not silently fall back to unprotected export.
+    return nullptr;
+  }
+  buffer->retained_image_ = std::move(protected_image);
+  return buffer;
+}
