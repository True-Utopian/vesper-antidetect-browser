+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_VESPER_CANVAS_READBACK_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_VESPER_CANVAS_READBACK_H_
+
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink {
+
+// Anything other than exactly 16 ASCII hex digits disables masking.
+PLATFORM_EXPORT std::optional<uint64_t> ParseVesperCanvasSeed(
+    std::string_view encoded);
+
+// The immutable renderer command line is scoped to one Vesper profile and
+// cached once per process. Policy changes require restarting the renderer.
+PLATFORM_EXPORT std::optional<uint64_t> VesperCanvasSeedFromCommandLine();
+
+// This initial policy supports RGBA8/BGRA8; float formats remain unsupported.
+PLATFORM_EXPORT bool IsVesperCanvasReadbackFormat(const SkPixmap& source);
+
+// Mutates only a caller-owned, RGBA8 unpremultiplied readback buffer, never a
+// canvas backing image. Absolute coordinates preserve overlapping-read equality.
+PLATFORM_EXPORT void ApplyVesperCanvasReadbackProtection(
+    const SkPixmap& readback,
+    int origin_x,
+    int origin_y,
+    uint64_t seed);
+
+// Converts a supported source into an independent RGBA8 unpremultiplied image,
+// applies the same policy at (0, 0), then transfers ownership to an SkImage.
+// Returns nullptr for unsupported formats or allocation/conversion failure.
+PLATFORM_EXPORT sk_sp<SkImage> CreateVesperCanvasReadbackImage(
+    const SkPixmap& source,
+    uint64_t seed);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_VESPER_CANVAS_READBACK_H_
diff --git a/third_party/blink/renderer/platform/graphics/vesper_canvas_readback_test.cc b/third_party/blink/renderer/platform/graphics/vesper_canvas_readback_test.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/platform/graphics/vesper_canvas_readback_test.cc
@@ -0,0 +1,208 @@
+// Copyright 2026 true-utopian
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/graphics/vesper_canvas_readback.h"
+
+#include <array>
+#include <cstdlib>
+#include <limits>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/skia_span_util.h"
+
+namespace blink {
+namespace {
+
+constexpr uint64_t kSeed = UINT64_C(0x19dc2ef440ac13d1);
+
+SkImageInfo RgbaInfo(int width, int height) {
+  return SkImageInfo::Make(width, height, kRGBA_8888_SkColorType,
+                           kUnpremul_SkAlphaType);
+}
+
+TEST(VesperCanvasReadbackTest, StrictSeedParsingAndZeroIsEnabled) {
+  for (const char* invalid : {"", "1", "0123456789abcde", "0123456789abcdef0",
+                              "0x123456789abcde", " 123456789abcdef",
+                              "0123456789abcdeg", "-123456789abcdef"}) {
+    EXPECT_FALSE(ParseVesperCanvasSeed(invalid).has_value()) << invalid;
+  }
+  const auto zero = ParseVesperCanvasSeed("0000000000000000");
+  ASSERT_TRUE(zero.has_value());
+  EXPECT_EQ(*zero, 0u);
+  const auto maximum = ParseVesperCanvasSeed("FFFFFFFFFFFFFFFF");
+  ASSERT_TRUE(maximum.has_value());
+  EXPECT_EQ(*maximum, std::numeric_limits<uint64_t>::max());
+}
+
+TEST(VesperCanvasReadbackTest, PreservesAlphaTransparentRgbAndRowPadding) {
+  std::array<uint8_t, 24> storage = {
+      17, 29, 43, 0, 101, 111, 121, 127, 91, 92, 93, 94,
+      255, 0, 200, 255, 80, 81, 82, 255, 95, 96, 97, 98};
+  const auto original = storage;
+  const SkPixmap pixmap(RgbaInfo(2, 2), storage.data(), 12);
+  ApplyVesperCanvasReadbackProtection(pixmap, -3, 7, kSeed);
+  for (size_t y = 0; y < 2; ++y) {
+    for (size_t x = 0; x < 2; ++x) {
+      const size_t offset = y * 12 + x * 4;
+      EXPECT_EQ(storage[offset + 3], original[offset + 3]);
+      for (size_t channel = 0; channel < 3; ++channel) {
+        if (original[offset + 3] == 0) {
+          EXPECT_EQ(storage[offset + channel], original[offset + channel]);
+        } else {
+          EXPECT_LE(std::abs(static_cast<int>(storage[offset + channel]) -
+                             static_cast<int>(original[offset + channel])), 1);
+        }
+      }
+    }
+    for (size_t pad = 8; pad < 12; ++pad) {
+      EXPECT_EQ(storage[y * 12 + pad], original[y * 12 + pad]);
+    }
+  }
+}
+
+TEST(VesperCanvasReadbackTest, RepeatedAndReappliedReadsDoNotAccumulate) {
+  std::array<uint8_t, 64> first;
+  first.fill(255);
+  auto second = first;
+  const auto info = RgbaInfo(4, 4);
+  ApplyVesperCanvasReadbackProtection(SkPixmap(info, first.data(), 16),
+                                    0, 0, kSeed);
+  const auto once = first;
+  ApplyVesperCanvasReadbackProtection(SkPixmap(info, first.data(), 16),
+                                    0, 0, kSeed);
+  ApplyVesperCanvasReadbackProtection(SkPixmap(info, second.data(), 16),
+                                    0, 0, kSeed);
+  EXPECT_EQ(first, once);
+  EXPECT_EQ(second, once);
+}
+
+TEST(VesperCanvasReadbackTest, SubrectUsesAbsoluteCoordinates) {
+  std::array<uint8_t, 64> whole;
+  whole.fill(255);
+  std::array<uint8_t, 16> subrect;
+  subrect.fill(255);
+  ApplyVesperCanvasReadbackProtection(
+      SkPixmap(RgbaInfo(4, 4), whole.data(), 16), -2, -3, kSeed);
+  ApplyVesperCanvasReadbackProtection(
+      SkPixmap(RgbaInfo(2, 2), subrect.data(), 8), -1, -2, kSeed);
+  for (size_t y = 0; y < 2; ++y) {
+    for (size_t x = 0; x < 2; ++x) {
+      for (size_t channel = 0; channel < 4; ++channel) {
+        EXPECT_EQ(whole[(y + 1) * 16 + (x + 1) * 4 + channel],
+                  subrect[y * 8 + x * 4 + channel]);
+      }
+    }
+  }
+}
+
+TEST(VesperCanvasReadbackTest, DifferentProfileSeedsChangeAnOpaqueDrawing) {
+  std::array<uint8_t, 1024> first;
+  first.fill(255);
+  auto second = first;
+  const auto info = RgbaInfo(16, 16);
+  ApplyVesperCanvasReadbackProtection(SkPixmap(info, first.data(), 64),
+                                    0, 0, kSeed);
+  ApplyVesperCanvasReadbackProtection(SkPixmap(info, second.data(), 64),
+                                    0, 0, kSeed + 1);
+  EXPECT_NE(first, second);
+}
+
+TEST(VesperCanvasReadbackTest, Float16RemainsExplicitlyUnsupported) {
+  std::array<uint16_t, 8> pixels;
+  pixels.fill(0x3c00);
+  const auto original = pixels;
+  const SkImageInfo info = SkImageInfo::Make(
+      2, 1, kRGBA_F16_SkColorType, kUnpremul_SkAlphaType);
+  const SkPixmap source(info, pixels.data(), info.minRowBytes());
+  EXPECT_FALSE(IsVesperCanvasReadbackFormat(source));
+  ApplyVesperCanvasReadbackProtection(source, 0, 0, kSeed);
+  EXPECT_EQ(pixels, original);
+  EXPECT_FALSE(CreateVesperCanvasReadbackImage(source, kSeed));
+}
+
+TEST(VesperCanvasReadbackTest, ExportCopyPreservesBackingAndMatchesReadback) {
+  // BGRA input exercises the native export color conversion path.
+  std::array<uint8_t, 16> source_bytes = {
+      200, 100, 50, 255, 40, 60, 80, 255,
+      70, 90, 110, 255, 120, 140, 160, 255};
+  const auto original = source_bytes;
+  const SkImageInfo source_info = SkImageInfo::Make(
+      2, 2, kBGRA_8888_SkColorType, kUnpremul_SkAlphaType);
+  const SkPixmap source(source_info, source_bytes.data(), 8);
+  std::array<uint8_t, 16> expected;
+  ASSERT_TRUE(source.readPixels(RgbaInfo(2, 2), expected.data(), 8, 0, 0));
+  ApplyVesperCanvasReadbackProtection(
+      SkPixmap(RgbaInfo(2, 2), expected.data(), 8), 0, 0, kSeed);
+  auto protected_image = CreateVesperCanvasReadbackImage(source, kSeed);
+  ASSERT_TRUE(protected_image);
+  SkPixmap protected_pixels;
+  ASSERT_TRUE(protected_image->peekPixels(&protected_pixels));
+  EXPECT_EQ(source_bytes, original);
+  EXPECT_NE(protected_pixels.addr(), source.addr());
+  EXPECT_EQ(protected_pixels.colorType(), kRGBA_8888_SkColorType);
+  EXPECT_EQ(protected_pixels.alphaType(), kUnpremul_SkAlphaType);
+  const auto bytes = gfx::SkPixmapToSpan(protected_pixels);
+  ASSERT_EQ(bytes.size(), expected.size());
+  for (size_t i = 0; i < bytes.size(); ++i) {
+    EXPECT_EQ(bytes[i], expected[i]);
+  }
+  // A second export independently copies the pristine backing pixels.
+  auto second_image = CreateVesperCanvasReadbackImage(source, kSeed);
+  ASSERT_TRUE(second_image);
+  SkPixmap second_pixels;
+  ASSERT_TRUE(second_image->peekPixels(&second_pixels));
+  EXPECT_EQ(gfx::SkPixmapToSpan(second_pixels), bytes);
+}
+
+TEST(VesperCanvasReadbackTest, PremultipliedExportMatchesUnpremultipliedReadback) {
+  // Rendering storage is normally premultiplied; preserve conversion rounding
+  // by using the same native readPixels contract before applying the policy.
+  std::array<uint8_t, 8> pixels = {10, 20, 30, 127, 0, 0, 0, 0};
+  const auto original = pixels;
+  const SkImageInfo source_info = SkImageInfo::Make(
+      2, 1, kRGBA_8888_SkColorType, kPremul_SkAlphaType);
+  const SkPixmap source(source_info, pixels.data(), 8);
+  std::array<uint8_t, 8> expected;
+  ASSERT_TRUE(source.readPixels(RgbaInfo(2, 1), expected.data(), 8, 0, 0));
+  ApplyVesperCanvasReadbackProtection(
+      SkPixmap(RgbaInfo(2, 1), expected.data(), 8), 0, 0, kSeed);
+  auto image = CreateVesperCanvasReadbackImage(source, kSeed);
+  ASSERT_TRUE(image);
+  SkPixmap readback;
+  ASSERT_TRUE(image->peekPixels(&readback));
+  const auto bytes = gfx::SkPixmapToSpan(readback);
+  ASSERT_EQ(bytes.size(), expected.size());
+  for (size_t i = 0; i < expected.size(); ++i) {
+    EXPECT_EQ(bytes[i], expected[i]);
+  }
+  EXPECT_EQ(bytes[3], 127);
+  EXPECT_EQ(bytes[4], 0);
+  EXPECT_EQ(bytes[5], 0);
+  EXPECT_EQ(bytes[6], 0);
+  EXPECT_EQ(bytes[7], 0);
+  EXPECT_EQ(pixels, original);
+}
+
+TEST(VesperCanvasReadbackTest, OpaqueExportMaterializesAlphaWithoutMutatingSource) {
+  std::array<uint8_t, 8> pixels = {20, 40, 60, 0, 100, 120, 140, 7};
+  const auto original = pixels;
+  const SkImageInfo info = SkImageInfo::Make(
+      2, 1, kRGBA_8888_SkColorType, kOpaque_SkAlphaType);
+  auto image = CreateVesperCanvasReadbackImage(
+      SkPixmap(info, pixels.data(), 8), kSeed);
+  ASSERT_TRUE(image);
+  SkPixmap readback;
+  ASSERT_TRUE(image->peekPixels(&readback));
+  const auto bytes = gfx::SkPixmapToSpan(readback);
+  EXPECT_EQ(bytes[3], 255);
+  EXPECT_EQ(bytes[7], 255);
+  EXPECT_EQ(pixels, original);
+  for (size_t i : {0u, 1u, 2u, 4u, 5u, 6u}) {
+    EXPECT_LE(std::abs(static_cast<int>(bytes[i]) -
+                       static_cast<int>(original[i])), 1);
+  }
+}
