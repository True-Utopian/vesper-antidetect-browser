diff --git a/third_party/blink/renderer/platform/graphics/vesper_canvas_readback.cc b/third_party/blink/renderer/platform/graphics/vesper_canvas_readback.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/platform/graphics/vesper_canvas_readback.cc
@@ -0,0 +1,138 @@
+// Copyright 2026 true-utopian
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/graphics/vesper_canvas_readback.h"
+
+#include <string_view>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "ui/gfx/skia_span_util.h"
+
+namespace blink {
+namespace {
+
+constexpr char kCanvasSeedSwitch[] = "vesper-canvas-seed";
+
+// Deterministic integer avalanche, not a cryptographic privacy primitive.
+uint64_t MixCanvasCoordinate(uint64_t value) {
+  value ^= value >> 30;
+  value *= UINT64_C(0xbf58476d1ce4e5b9);
+  value ^= value >> 27;
+  value *= UINT64_C(0x94d049bb133111eb);
+  return value ^ (value >> 31);
+}
+
+}  // namespace
+
+std::optional<uint64_t> ParseVesperCanvasSeed(std::string_view encoded) {
+  if (encoded.size() != 16) {
+    return std::nullopt;
+  }
+  for (char c : encoded) {
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') ||
+          (c >= 'A' && c <= 'F'))) {
+      return std::nullopt;
+    }
+  }
+  uint64_t seed = 0;
+  if (!base::HexStringToUInt64(encoded, &seed)) {
+    return std::nullopt;
+  }
+  return seed;
+}
+
+std::optional<uint64_t> VesperCanvasSeedFromCommandLine() {
+  // A renderer belongs to one profile. Parse its immutable startup policy once,
+  // including on worker threads; pages cannot change this process-local value.
+  static const std::optional<uint64_t> seed = ParseVesperCanvasSeed(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kCanvasSeedSwitch));
+  return seed;
+}
+
+bool IsVesperCanvasReadbackFormat(const SkPixmap& source) {
+  return source.colorType() == kRGBA_8888_SkColorType ||
+         source.colorType() == kBGRA_8888_SkColorType;
+}
+
+void ApplyVesperCanvasReadbackProtection(const SkPixmap& readback,
+                                        int origin_x,
+                                        int origin_y,
+                                        uint64_t seed) {
+  if (readback.colorType() != kRGBA_8888_SkColorType ||
+      readback.alphaType() != kUnpremul_SkAlphaType ||
+      !readback.writable_addr() || readback.width() <= 0 ||
+      readback.height() <= 0 ||
+      readback.rowBytes() < readback.info().minRowBytes()) {
+    return;
+  }
+  auto bytes = gfx::SkPixmapToWritableSpan(readback);
+  if (bytes.empty()) {
+    return;
+  }
+  for (int y = 0; y < readback.height(); ++y) {
+    const uint64_t absolute_y =
+        static_cast<uint64_t>(static_cast<int64_t>(origin_y) + y);
+    const uint64_t row_key = MixCanvasCoordinate(
+        seed ^ MixCanvasCoordinate(absolute_y ^ UINT64_C(0x9e3779b97f4a7c15)));
+    auto row = bytes.subspan(static_cast<size_t>(y) * readback.rowBytes(),
+                             readback.info().minRowBytes());
+    for (int x = 0; x < readback.width(); ++x) {
+      auto pixel = row.subspan(static_cast<size_t>(x) * size_t{4}, size_t{4});
+      if (pixel[3] == 0) {
+        continue;
+      }
+      const uint64_t absolute_x =
+          static_cast<uint64_t>(static_cast<int64_t>(origin_x) + x);
+      const uint64_t bits = MixCanvasCoordinate(
+          row_key ^ MixCanvasCoordinate(absolute_x ^ UINT64_C(0xd1b54a32d192ed03)));
+      for (size_t channel = 0; channel < 3; ++channel) {
+        // Setting a low bit, rather than toggling it, is idempotent and changes
+        // each RGB byte by at most one. Alpha and transparent RGB stay intact.
+        pixel[channel] = static_cast<uint8_t>(
+            (pixel[channel] & 0xfe) | ((bits >> channel) & 1));
+      }
+    }
+  }
+}
+
+sk_sp<SkImage> CreateVesperCanvasReadbackImage(const SkPixmap& source,
+                                             uint64_t seed) {
+  if (!IsVesperCanvasReadbackFormat(source) || !source.addr() ||
+      source.width() <= 0 || source.height() <= 0) {
+    return nullptr;
+  }
+  const SkImageInfo info = source.info()
+                               .makeColorType(kRGBA_8888_SkColorType)
+                               .makeAlphaType(kUnpremul_SkAlphaType);
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(size)) {
+    return nullptr;
+  }
+  sk_sp<SkData> data = SkData::MakeUninitialized(size);
+  // SkPixmap rejects opaque -> unpremul conversion. Copy as opaque first,
+  // then explicitly materialize alpha=255 in the private RGBA buffer.
+  const SkImageInfo conversion_info = source.alphaType() == kOpaque_SkAlphaType
+                                          ? info.makeAlphaType(kOpaque_SkAlphaType)
+                                          : info;
+  if (!data || !source.readPixels(conversion_info, data->writable_data(),
+                                  row_bytes, 0, 0)) {
+    return nullptr;
+  }
+  SkPixmap readback(info, data->writable_data(), row_bytes);
+  if (source.alphaType() == kOpaque_SkAlphaType) {
+    auto bytes = gfx::SkPixmapToWritableSpan(readback);
+    for (size_t alpha = 3; alpha < bytes.size(); alpha += 4) {
+      bytes[alpha] = 255;
+    }
+  }
+  ApplyVesperCanvasReadbackProtection(readback, 0, 0, seed);
+  return SkImages::RasterFromData(info, std::move(data), row_bytes);
+}
+
+}  // namespace blink
